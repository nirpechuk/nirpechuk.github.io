{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "nir-site-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/",
      "/session",
      "/r/*",
      "/research",
      "/research/*",
      "/admin",
      "/admin/*",
      "/api/publish/*",
      "/fitness",
      "/fitness/*",
      "/flats",
      "/flats/*",
      "/media/*",
      "/assets/video/*",
      "/talks/*/video/*",
      "/api/media/*",
    ],
  },
  "services": [
    {
      "binding": "FITNESS",
      "service": "nir-fitness",
    },
    {
      "binding": "FLATS",
      "service": "nir-flats",
    },
  ],
  "r2_buckets": [
    {
      "binding": "RESEARCH",
      "bucket_name": "nir-research",
    },
    {
      "binding": "MEDIA",
      "bucket_name": "nir-media",
    },
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1,
    },
  },
  "env": {
    "production": {
      "name": "nir-site",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "nir.pechuk.com",
          "custom_domain": true,
        },
        { "pattern": "reports.pechuk.com", "custom_domain": true },
      ],
      "services": [
        {
          "binding": "FITNESS",
          "service": "nir-fitness",
        },
        {
          "binding": "FLATS",
          "service": "nir-flats",
        },
      ],
      "r2_buckets": [
        {
          "binding": "RESEARCH",
          "bucket_name": "nir-research",
        },
        {
          "binding": "MEDIA",
          "bucket_name": "nir-media",
        },
      ],
    },
  },
  "account_id": "f5542da2ba1d6b3830a7e089947a50f7",
}
