<article class="project-card">
  <a class="project-image" href="{{ project.url | relative_url }}" aria-label="Read about {{ project.title | escape }}">
    <img src="{{ project.img | relative_url }}" alt="{{ project.image_alt | escape }}" width="640" height="360" loading="lazy">
  </a>
  <div class="project-body">
    <p class="project-context">{{ project.category }}</p>
    <h2>
      <a href="{{ project.url | relative_url }}">{{ project.title }}</a>
    </h2>
    <p>{{ project.description }}</p>
    <p class="project-tech">{{ project.technologies }}</p>
    {% include project_links.liquid links=project.links %}
    {% if project.links.size == 0 %}
      <div class="project-links"><a href="{{ project.url | relative_url }}">Overview</a></div>
    {% endif %}
  </div>
</article>
